<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CheemsFileManagerPC</AssemblyName>
    <Version>0.7.0</Version>
    <ApplicationIcon>branding\cfm_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="branding\cfm_icon.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
    <EmbeddedResource Include="ui\index.html" LogicalName="CFM.UI.index.html"/>
    <EmbeddedResource Include="ui\style.css" LogicalName="CFM.UI.style.css"/>
    <EmbeddedResource Include="ui\app.js" LogicalName="CFM.UI.app.js"/>
  </ItemGroup>
</Project>
